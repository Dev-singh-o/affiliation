# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Pooled connection string used by the running app (Prisma + @prisma/adapter-pg).
# Neon dashboard -> Connection string -> "Pooled connection".
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Unpooled/direct endpoint, required for Prisma migrations.
# Neon dashboard -> Connection string -> disable "Pooled connection".
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication (Auth.js v5)
# ---------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the deployment. Required in production, optional locally.
# AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Public site URL (used for canonical URLs, sitemap, OG tags)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# "s3"     -> S3-compatible object storage (production; requires S3_* vars below)
# "local"  -> dev-only: writes to public/uploads and serves from /uploads
# Default: "s3" when all S3_* vars are present, otherwise "local" in development.
STORAGE_DRIVER="local"

# S3-compatible storage (Cloudflare R2, AWS S3, MinIO, Supabase Storage, ...)
# S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET="affiliate-uploads"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Public base URL where uploaded objects are served from (CDN or bucket URL):
# S3_PUBLIC_URL="https://cdn.example.com"
